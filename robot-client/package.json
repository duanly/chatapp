{
  "name": "chatapp-robot-client",
  "version": "1.0.0",
  "description": "轻聊机器人客户端",
  "main": "electron-main.js",
  "scripts": {
    "start": "node index.js",
    "app": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "chokidar": "^3.6.0",
    "express": "^4.18.0",
    "socket.io-client": "^4.7.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.chatapp.robot",
    "productName": "轻聊机器人",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "electron-main.js",
      "preload.js",
      "panel-page.js",
      "config.js",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  }
}
