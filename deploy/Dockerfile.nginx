# 多阶段构建：先构建 web，再构建 admin，最后合入 nginx
FROM node:18-alpine AS build-web
WORKDIR /app
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM node:18-alpine AS build-admin
WORKDIR /app
COPY admin/package*.json ./
RUN npm ci
COPY admin/ ./
ENV VITE_BASE_PATH=/admin/
ENV VITE_API_BASE_URL=/api/admin
RUN npm run build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=build-web /app/dist /usr/share/nginx/html/web
COPY --from=build-admin /app/dist /usr/share/nginx/html/admin
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
