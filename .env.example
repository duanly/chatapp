# ========== 数据库配置 ==========
POSTGRES_DB=chatapp
POSTGRES_USER=chatapp
POSTGRES_PASSWORD=chatapp123

# ========== 服务端配置 ==========
NODE_ENV=production
PORT=3000
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=chatapp
DB_PASSWORD=chatapp123
DB_NAME=chatapp
REDIS_HOST=redis
REDIS_PORT=6379
JWT_SECRET=change_this_to_a_random_secret_key
JWT_EXPIRES_IN=7d

# ========== OSS 配置（可选，不配置则用本地存储） ==========
# OSS_REGION=oss-cn-guangzhou
# OSS_BUCKET=your-bucket
# OSS_ACCESS_KEY_ID=your-access-key
# OSS_ACCESS_KEY_SECRET=your-access-secret
# OSS_DOMAIN=https://cdn.example.com
# OSS_PREFIX=chatapp
# OSS_ROLE_ARN=acs:ram::xxxxxxx:role/chatapp-upload-role

# ========== 机器人配置 ==========
SERVER_URL=http://server:3000
API_KEY=your_robot_api_key_here
BIZ_SERVER_IP=127.0.0.1
ENABLE_BIZ_WS=true
ENABLE_MESSAGE_FORWARD=true
FORWARD_CHAT_API=/api/chat
FORWARD_RECALL_API=/api/recallmsg
ADD_PAOCHAT_API=/api/addpaochatuser
ENABLE_ADD_PAOCHAT_USER=false
PANEL_PORT=7777
ENABLE_FOLDER_WATCH=false
WATCH_FOLDER=/data/watch
ROBOT_OSS_PREFIX=robot
